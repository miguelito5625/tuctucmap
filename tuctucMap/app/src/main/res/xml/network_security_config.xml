<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- [SEC-06] Bloquea terminantemente todo tráfico HTTP en texto claro -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>

