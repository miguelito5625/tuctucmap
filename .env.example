# ============================================================================
# PLANTILLA DE VARIABLES DE ENTORNO (.env.example)
# Copia este archivo como `.env` en la raíz del proyecto y coloca tus datos reales.
# ============================================================================

# 1. Credenciales de Base de Datos PostgreSQL (Supabase Direct Connection)
DB_HOST=db.TU_PROYECTO.supabase.co
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=TU_PASSWORD_SEGURO_DE_SUPABASE
DB_NAME=postgres

# 2. Credenciales de API de Supabase (App Android & Dashboard Angular)
SUPABASE_URL=https://TU_PROYECTO.supabase.co
SUPABASE_ANON_KEY=TU_SUPABASE_ANON_KEY

# 3. Firebase Realtime Database
FIREBASE_RTDB_URL=https://TU_PROYECTO-default-rtdb.firebaseio.com

# 4. Datos Operativos y Bancarios del Dueño de la App
ADMIN_WHATSAPP_PHONE=502XXXXXXXX
BANRURAL_ACCOUNT=XXXX-XXXX-XX
BI_ACCOUNT=XXX-XXXXXX-X
PRICE_SEMANAL=25.00
PRICE_QUINCENAL=45.00
PRICE_MENSUAL=80.00
MAX_SEARCH_RADIUS_KM=5.0
